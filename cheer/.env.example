# Judgey live mode (docs/backend-spec.md §8). Copy to .env.local and fill in.
# With none of these set, the app runs the demo meet only (zero config).

# Supabase project URL and its new-style publishable key (sb_publishable_…).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: Cloudflare Turnstile site key. When set, anonymous sign-in sends a
# Turnstile token (turn on CAPTCHA protection in Supabase Auth to match).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
