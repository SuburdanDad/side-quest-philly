{
  "name": "judgey",
  "version": "0.1.0",
  "private": true,
  "description": "Judgey: cheer competition companion. Live 'when do we go on?' ETAs for parents + positive real-time fan voting.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "next dev --port 3004",
    "build": "next build",
    "start": "next start --port 3004",
    "lint": "eslint",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:domain": "tsc --noEmit -p tsconfig.domain.json",
    "test:db": "node --experimental-strip-types --no-warnings --test test/db/*.test.ts",
    "import:meet": "node --experimental-strip-types --no-warnings scripts/import-meet.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.7",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.49.0",
    "next": "^16.2.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
